{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // TS 6: "types" vale [] di default, describe/it/expect (globali di Vitest
    // con l'API jest) vanno richiamati esplicitamente.
    "types": ["node", "jest"],
    "rootDir": "."
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
