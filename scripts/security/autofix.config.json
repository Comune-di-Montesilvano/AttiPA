{
  "pnpmDirs": ["."],
  "dockerfiles": {
    "backend": "apps/backend/Dockerfile",
    "frontend-admin": "apps/frontend-admin/Dockerfile",
    "tinn-gateway": "services/tinn-gateway/Dockerfile",
    "docgen": "services/docgen/Dockerfile"
  },
  "extraDockerfiles": [
    "apps/backend/Dockerfile.dev",
    "apps/frontend-admin/Dockerfile.dev",
    "services/tinn-gateway/Dockerfile.dev",
    "services/docgen/Dockerfile.dev"
  ],
  "allowedFiles": [
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "package.json",
    "apps/*/package.json",
    "packages/*/package.json",
    "services/*/requirements.in",
    "services/*/requirements.txt",
    "services/*/requirements-dev.in",
    "services/*/requirements-dev.txt",
    "apps/*/Dockerfile",
    "apps/*/Dockerfile.dev",
    "services/*/Dockerfile",
    "services/*/Dockerfile.dev"
  ],
  "pip": { "dir": "services/docgen" }
}
