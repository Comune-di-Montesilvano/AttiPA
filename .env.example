# AttiPA — esempio di configurazione. Copiare in .env (mai versionato) e adattare.

# ── Compose ───────────────────────────────────────────────────────────────────
# SOLO SVILUPPO: attiva l'override con bind mount e hot-reload.
# Windows usa ";" come separatore, Linux/macOS ":". In produzione NON impostarla.
#COMPOSE_FILE=docker-compose.yml;docker-compose.override.yml

# Tag delle immagini di produzione (es. v0.1.0). Default: latest.
IMAGE_TAG=latest
# Verifica le firme cosign prima di avviare le immagini (consigliato in produzione).
#VERIFY_IMAGES=true

# ── Porte host ────────────────────────────────────────────────────────────────
# BACKEND_PORT solo in sviluppo.
BACKEND_PORT=8080
ADMIN_PORT=3000

LOG_LEVEL=info

# ── DB Tinn (tinn-gateway) ───────────────────────────────────────────────────
# Backup notturno del fornitore via SFTP (stessi valori di tinn-contabilita).
TINN_SFTP_HOST=
TINN_SFTP_PORT=22
TINN_SFTP_USER=
# Password con $, spazi o #: tra apici singoli
TINN_SFTP_PASSWORD=
# Percorso dello zip sul server SFTP
TINN_SFTP_PATH=
# Nome del .fbk dentro lo zip
TINN_DB_FILE=
# Facoltativa: chiave host «tipo base64» (altrimenti fissata al primo collegamento)
TINN_SFTP_HOST_KEY=
# Ora della sync giornaliera, ora italiana (il fornitore scrive lo zip verso le 05:00).
# Se fallisce riprova ogni 30 minuti per 4 ore. Vuota = solo a mano.
TINN_SYNC_HOUR=6
# Solo sviluppo: cartella host con zip/fbk già scaricati, montata su /backup
#TINN_BACKUP_DIR=C:/Users/<utente>/Downloads

# ── IA ────────────────────────────────────────────────────────────────────────
# Qualsiasi endpoint compatibile OpenAI (Ollama, vLLM, LocalAI) o un provider cloud
# con contratto e DPA dell'ente. Dati personali: mai verso servizi senza DPA.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_MODEL=
