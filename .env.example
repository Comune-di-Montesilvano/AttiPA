# AttiPA — esempio di configurazione. Copiare in .env (mai versionato) e adattare.

# ── Compose ───────────────────────────────────────────────────────────────────
# SOLO SVILUPPO: attiva l'override con bind mount e hot-reload.
# Windows usa ";" come separatore, Linux/macOS ":". In produzione NON impostarla.
#COMPOSE_FILE=docker-compose.yml;docker-compose.override.yml

# Tag delle immagini di produzione (es. v0.1.0). Default: latest.
IMAGE_TAG=latest
# Verifica le firme cosign prima di avviare le immagini (consigliato in produzione).
#VERIFY_IMAGES=true

# ── Porte host ────────────────────────────────────────────────────────────────
# BACKEND_PORT solo in sviluppo.
BACKEND_PORT=8080
ADMIN_PORT=3000

LOG_LEVEL=info

# ── Database (Postgres 18 + pgvector) ────────────────────────────────────────
POSTGRES_USER=attipa
# openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=attipa
# Solo sviluppo: porta host (solo 127.0.0.1)
#POSTGRES_PORT=5432

# ── Autenticazione operatori (Active Directory) ──────────────────────────────
# openssl rand -hex 32 (obbligatorio, almeno 32 caratteri fuori dallo sviluppo)
JWT_SECRET=
# Durata della sessione in secondi (default 8 ore)
#JWT_EXPIRES_IN_SECONDS=28800
# ldaps://dc.comune.local:636 oppure ldap://dc.comune.local:389 (+ LDAP_STARTTLS=true).
# SOLO SVILUPPO: LDAP_HOST=mock → admin/admin e operator/operator. Un'istanza avviata
# una volta con LDAP reale rifiuta poi l'avvio in mock.
LDAP_HOST=
LDAP_BASE_DN=DC=comune,DC=local
# Bind dell'utente: %s = username digitato (UPN o DN)
LDAP_USER_DN_TEMPLATE=%s@comune.local
LDAP_STARTTLS=false
# Solo per certificati interni non verificabili: meglio false
LDAP_TLS_SKIP_VERIFY=false
# Gruppi AD (CN, anche annidati): accesso e amministrazione
LDAP_REQUIRED_GROUP=ATTIPA_USERS
LDAP_ADMIN_GROUP=ATTIPA_ADMINS
# Username sempre admin, separati da virgola
LDAP_ADMIN_USERNAMES=

# ── DB Tinn (tinn-gateway) ───────────────────────────────────────────────────
# Backup notturno del fornitore via SFTP (stessi valori di tinn-contabilita).
TINN_SFTP_HOST=
TINN_SFTP_PORT=22
TINN_SFTP_USER=
# Password con $, spazi o #: tra apici singoli
TINN_SFTP_PASSWORD=
# Percorso dello zip sul server SFTP
TINN_SFTP_PATH=
# Nome del .fbk dentro lo zip
TINN_DB_FILE=
# Facoltativa: chiave host «tipo base64» (altrimenti fissata al primo collegamento)
TINN_SFTP_HOST_KEY=
# Ora della sync giornaliera, ora italiana (il fornitore scrive lo zip verso le 05:00).
# Se fallisce riprova ogni 30 minuti per 4 ore. Vuota = solo a mano.
TINN_SYNC_HOUR=6
# Solo sviluppo: cartella host con zip/fbk già scaricati, montata su /backup
#TINN_BACKUP_DIR=C:/Users/<utente>/Downloads

# ── IA ────────────────────────────────────────────────────────────────────────
# Qualsiasi endpoint compatibile OpenAI (Ollama, vLLM, LocalAI) o un provider cloud
# con contratto e DPA dell'ente. Dati personali: mai verso servizi senza DPA.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_MODEL=
